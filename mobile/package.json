{
  "name": "otix-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Otix Native Mobile Application for iOS and Android",
  "scripts": {
    "build:frontend": "npm --prefix ../frontend run build",
    "cap:sync": "npm run build:frontend && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:run:ios": "npm run build:frontend && npx cap run ios",
    "cap:run:android": "npm run build:frontend && npx cap run android"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.2",
    "@capacitor/browser": "^6.0.4",
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/keyboard": "^6.0.3",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/screen-orientation": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "typescript": "^7.0.2"
  }
}
