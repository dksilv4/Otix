{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://otix.app/plugin-manifest.schema.json",
  "title": "Otix plugin manifest",
  "type": "object",
  "description": "Schema for a plugin's manifest.json. The authoritative runtime gate is desktop/plugins/manifest-validation.ts; this file exists so editors can surface most mistakes at author time.",
  "required": ["name", "version", "description", "author", "permissions", "entry"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "repository": { "type": "string" },
    "min_app_version": { "type": "string" },
    "timeout": { "type": "number", "minimum": 0 },
    "icon": { "type": "string" },
    "stage": { "enum": ["alpha", "beta", "stable"] },
    "system": { "type": "boolean" },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "anyOf": [
          { "enum": [
              "network:external",
              "storage:local",
              "events:subscribe",
              "ui:settings",
              "ui:media.actions",
              "ui:list.actions",
              "ui:nav.item",
              "ui:dashboard.widget",
              "notifications",
              "api:proxy",
              "worker:filesystem",
              "ui:command"
          ] },
          { "pattern": "^table:[a-zA-Z_][a-zA-Z0-9_]*$" }
        ]
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/configField" }
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["location", "label"],
        "properties": {
          "location": { "type": "string" },
          "label": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "tabs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "path", "sections"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "icon": { "type": "string" },
              "path": { "type": "string" },
              "sections": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "label", "slot"],
                  "properties": {
                    "id": { "type": "string" },
                    "label": { "type": "string" },
                    "slot": { "type": "string" },
                    "config": { "type": "boolean" }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "services": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string" },
              "protocol": { "type": "string" }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "depends_on": { "type": "array", "items": { "type": "string" } },
    "db": {
      "type": "object",
      "properties": {
        "tables": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["columns"],
            "properties": {
              "columns": {
                "type": "object",
                "additionalProperties": { "type": "string", "minLength": 1 }
              },
              "indexes": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "entry": {
      "type": "object",
      "required": ["main"],
      "properties": { "main": { "type": "string", "minLength": 1 } },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "definitions": {
    "configField": {
      "type": "object",
      "required": ["type", "label"],
      "properties": {
        "type": {
          "enum": [
            "string",
            "number",
            "boolean",
            "secret",
            "enum",
            "select",
            "uuid",
            "list",
            "path-list",
            "object",
            "instances",
            "serverUrl"
          ]
        },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "advanced": { "type": "boolean" },
        "section": { "type": "string" },
        "order": { "type": "number" },
        "placeholder": { "type": "string" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number" },
        "pattern": { "type": "string" },
        "sensitive": { "type": "boolean" },
        "fetchable": { "type": "boolean" },
        "parts": { "type": "array", "items": { "type": "string" } },
        "default": {},
        "values": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" } },
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["value", "label"],
                "properties": {
                  "value": { "type": "string" },
                  "label": { "type": "string" }
                },
                "additionalProperties": true
              }
            }
          ]
        },
        "items": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/configField" }
        },
        "if": {
          "type": "object",
          "required": ["field"],
          "properties": {
            "field": { "type": "string" },
            "equals": {},
            "not": {},
            "truthy": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "connection": {
          "type": "object",
          "properties": {
            "method": { "type": "string" },
            "fields": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
