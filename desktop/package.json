{
  "name": "desktop",
  "private": true,
  "version": "0.0.0",
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "patch-package && electron-rebuild -f -w better-sqlite3",
    "dev": "concurrently -k -n \"vite,tsc,electron\" -c \"cyan,blue,magenta\" \"cd ../frontend && npm run dev\" \"tsc --watch\" \"electron-rebuild -f -w better-sqlite3 && wait-on http://127.0.0.1:5173 dist/ipc/scanner.js && cross-env NODE_ENV=development electron .\"",
    "build": "tsc",
    "pretest": "npm rebuild better-sqlite3",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "concurrently": "^10.0.1",
    "cross-env": "^10.1.0",
    "electron": "^42.3.0",
    "electron-rebuild": "^3.2.9",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.10"
  }
}
