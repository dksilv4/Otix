{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "../frontend/dist-electron",
    "rootDir": "./",
    "baseUrl": ".",
    "paths": {
      "electron": ["../frontend/node_modules/electron"]
    },
    "typeRoots": [
      "../frontend/node_modules/@types"
    ]
  },
  "include": ["**/*"]
}
