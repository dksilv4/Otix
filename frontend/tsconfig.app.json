{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@ui/*": ["./src/features/dk-ui/*"],
      "@ui": ["./src/features/dk-ui"],
      "@auth/*": ["./src/features/auth/*"],
      "@auth": ["./src/features/auth"],
      "@media/*": ["./src/features/media/*"],
      "@media": ["./src/features/media"],
      "@discover/*": ["./src/features/discover/*"],
      "@discover": ["./src/features/discover"],
      "@navigation/*": ["./src/features/navigation/*"],
      "@navigation": ["./src/features/navigation"],
      "@person/*": ["./src/features/person/*"],
      "@person": ["./src/features/person"],
      "@company/*": ["./src/features/company/*"],
      "@company": ["./src/features/company"],
      "@user/*": ["./src/features/user/*"],
      "@user": ["./src/features/user"],
      "@library/*": ["./src/features/library/*"],
      "@library": ["./src/features/library"],
      "@list/*": ["./src/features/list/*"],
      "@list": ["./src/features/list"],
      "@dk-ui/*": ["./src/features/dk-ui/*"],
      "@dk-ui": ["./src/features/dk-ui"]
    }
  },
  "include": ["src"]
}
