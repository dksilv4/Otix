@charset "UTF-8";
@reference "../../../../_tailwind-ref.css";
/* ── Scanner Game Card ── */
.dk-scanner {
  @apply relative aspect-[2/1] overflow-hidden rounded-xl cursor-pointer;
  background-color: var(--dk-surface-base);
  box-shadow: var(--dk-shadow-sm);
  transition: all 300ms;
}
.dk-scanner:hover {
  transform: scale(1.02);
  box-shadow: var(--dk-shadow-lg);
}
.dk-scanner {
  /* ── Background artwork ── */
}
.dk-scanner__bg-img {
  @apply absolute inset-0 h-full w-full object-cover;
  transition: transform 700ms ease-out;
  transform: scale(1.1);
}
.dk-scanner:hover .dk-scanner__bg-img {
  transform: scale(1);
}
.dk-scanner {
  /* ── Dark overlay ── */
}
.dk-scanner__overlay {
  @apply absolute inset-0;
  background-color: rgba(0, 0, 0, 0.35);
  transition: background-color 300ms;
}
.dk-scanner:hover .dk-scanner__overlay {
  background-color: rgba(0, 0, 0, 0.25);
}
.dk-scanner {
  /* ── Fallback gradient (unmatched / no artwork) ── */
}
.dk-scanner__fallback {
  @apply absolute inset-0;
}
.dk-scanner__fallback-icon {
  @apply absolute inset-0 flex items-center justify-center;
}
.dk-scanner__fallback-icon-img {
  height: 6rem;
  width: 6rem;
  @apply object-contain;
  opacity: 0.2;
  transition: opacity 300ms, transform 300ms;
}
.dk-scanner:hover .dk-scanner__fallback-icon-img {
  opacity: 0.35;
  transform: scale(1.1);
}
.dk-scanner__fallback-title {
  @apply absolute bottom-0 left-0 right-0 p-3 pt-10;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
}
.dk-scanner__fallback-title-text {
  @apply text-sm font-bold text-white leading-tight truncate;
}
.dk-scanner__fallback-title-sub {
  @apply mt-0.5 text-[11px] text-white/40 truncate;
}
.dk-scanner {
  /* ── Badge header ── */
}
.dk-scanner__header {
  @apply absolute top-2.5 left-2.5 right-2.5 z-10 flex items-center justify-between gap-2;
}
.dk-scanner__badge-wrapper {
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
  background-color: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}
.dk-scanner__matched-badge, .dk-scanner__suggestion-badge {
  @apply flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-semibold;
  background-color: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
}
.dk-scanner__matched-badge {
  @apply text-green-400;
}
.dk-scanner__suggestion-badge {
  @apply text-blue-400;
}
.dk-scanner {
  /* ── Logo ── */
}
.dk-scanner__logo {
  @apply absolute top-[8%] left-0 right-0 z-10 flex items-center justify-center px-6;
}
.dk-scanner__logo-img {
  max-height: 45%;
  max-width: 70%;
  @apply object-contain;
  transition: transform 500ms ease-out;
  filter: drop-shadow(0 2px 16px rgba(0, 0, 0, 0.8));
}
.dk-scanner:hover .dk-scanner__logo-img {
  transform: scale(1.05);
}
.dk-scanner {
  /* ── Footer / Title bar ── */
}
.dk-scanner__footer {
  @apply absolute bottom-0 left-0 right-0 z-10 p-3 pt-10;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.5) 50%, transparent 100%);
}
.dk-scanner__footer-title {
  @apply text-sm font-bold text-white leading-tight truncate;
  filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.9));
}
.dk-scanner__footer-sub {
  @apply mt-0.5 text-[11px] text-white/50 truncate;
}
.dk-scanner {
  /* ── Suggestion overlay (unmatched, prompt to match) ── */
}
.dk-scanner__suggestion-overlay {
  @apply absolute inset-0 z-20 flex items-center justify-center;
  transition: opacity 300ms;
}
.dk-scanner__suggestion-overlay--visible {
  @apply opacity-100;
}
.dk-scanner__suggestion-overlay--hidden {
  @apply opacity-0 pointer-events-none;
}
.dk-scanner__suggestion-bg {
  @apply absolute inset-0 rounded-xl;
  background-color: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}
.dk-scanner__suggestion-content {
  @apply relative z-10 flex flex-col items-center gap-3 px-4;
}
.dk-scanner__suggestion-text {
  @apply text-sm font-semibold text-white text-center leading-tight;
}
.dk-scanner__suggestion-match-label {
  @apply text-blue-400;
}
.dk-scanner__accept-btn {
  @apply inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-bold text-white;
  background-color: rgb(59, 130, 246);
  transition: background-color 200ms, transform 200ms;
}
.dk-scanner__accept-btn:hover {
  background-color: rgb(96, 165, 250);
  transform: scale(1.05);
}
.dk-scanner__accept-btn:active {
  transform: scale(0.95);
}
.dk-scanner__reject-btn {
  @apply inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-semibold;
  background-color: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.7);
  transition: background-color 200ms, color 200ms, transform 200ms;
}
.dk-scanner__reject-btn:hover {
  background-color: rgba(255, 255, 255, 0.2);
  color: rgb(255, 255, 255);
  transform: scale(1.05);
}
.dk-scanner__reject-btn:active {
  transform: scale(0.95);
}
.dk-scanner {
  /* ── Play overlay (matched games) ── */
}
.dk-scanner__play-overlay {
  @apply absolute inset-0 z-20 flex items-center justify-center;
  transition: opacity 300ms;
  background-color: rgba(0, 0, 0, 0.25);
}
.dk-scanner__play-overlay--visible {
  @apply opacity-100;
}
.dk-scanner__play-overlay--hidden {
  @apply opacity-0;
}
.dk-scanner__play-btn {
  @apply inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-bold text-white;
  background-color: #10b981;
  box-shadow: 0 25px 50px -12px rgba(16, 185, 129, 0.4);
  transition: background-color 200ms, transform 200ms;
}
.dk-scanner__play-btn:hover {
  background-color: #34d399;
  transform: scale(1.05);
}
.dk-scanner__play-btn:active {
  transform: scale(0.95);
}
.dk-scanner {
  /* ── Hover ring ── */
}
.dk-scanner__ring {
  @apply pointer-events-none absolute inset-0 rounded-xl;
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  transition: box-shadow 300ms;
}
.dk-scanner__ring--visible {
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2);
}
.dk-scanner {
  /* ── Fallback gamepad icon (unmatched) ── */
}
.dk-scanner__fallback-icon-gamepad {
  height: 5rem;
  width: 5rem;
  color: rgba(255, 255, 255, 0.1);
  transition: all 300ms;
}
.dk-scanner:hover .dk-scanner__fallback-icon-gamepad {
  color: rgba(255, 255, 255, 0.2);
  transform: scale(1.1);
}
.dk-scanner {
  /* ── Matched badge check icon ── */
}
.dk-scanner__matched-icon {
  height: 0.75rem;
  width: 0.75rem;
}
.dk-scanner {
  /* ── Accept button check icon ── */
}
.dk-scanner__accept-icon {
  height: 0.875rem;
  width: 0.875rem;
}
.dk-scanner {
  /* ── Play button icon ── */
}
.dk-scanner__play-icon {
  height: 1rem;
  width: 1rem;
  fill: currentColor;
}

/* ── Wrapper (Link / div) ── */
.dk-scanner-wrapper {
  @apply block;
}

