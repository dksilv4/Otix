<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.otix.node</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/otix-node</string>
        <string>-port</string>
        <string>8090</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/otix-node.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/otix-node.err.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
