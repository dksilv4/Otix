<?xml version="1.0"?>
<Container version="2">
  <Name>otix-server</Name>
  <Repository>ghcr.io/dksilv4/otix-server:latest</Repository>
  <Registry>https://ghcr.io/dksilv4/otix-server</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/dksilv4/Otix/issues</Support>
  <Project>https://otix.io</Project>
  <Overview>Plex for Games &amp; Cloud Saves on Unraid. Lightweight Go daemon hosting your game ISOs, installers, repacks, ROMs, and cloud save backup sync with automatic Plex-style account claiming.</Overview>
  <Category>MediaApp:Games Network:Web Status:Stable</Category>
  <WebUI>http://[IP]:[PORT:8090]/</WebUI>
  <Icon>https://raw.githubusercontent.com/dksilv4/Otix/main/assets/icon.png</Icon>
  <Description>Standalone 24/7 background worker for Otix. Features HTTP/2 range requests, Epic Games vault, automated cloud save snapshots, and Arr/Usenet integrations with instant Plex-style claim PIN onboarding.</Description>
  <Networking>
    <Mode>bridge</Mode>
    <Publish>
      <Port>
        <HostPort>8090</HostPort>
        <ContainerPort>8090</ContainerPort>
        <Protocol>tcp</Protocol>
      </Port>
    </Publish>
  </Networking>
  <Data>
    <Volume>
      <HostDir>/mnt/user/appdata/otix-server/config.yaml</HostDir>
      <ContainerDir>/app/config.yaml</ContainerDir>
      <Mode>rw</Mode>
    </Volume>
    <Volume>
      <HostDir>/mnt/user/games/</HostDir>
      <ContainerDir>/storage/installers</ContainerDir>
      <Mode>rw</Mode>
    </Volume>
    <Volume>
      <HostDir>/mnt/user/appdata/otix-server/saves/</HostDir>
      <ContainerDir>/storage/saves</ContainerDir>
      <Mode>rw</Mode>
    </Volume>
    <Volume>
      <HostDir>/mnt/user/appdata/otix-server/storage/</HostDir>
      <ContainerDir>/app/storage</ContainerDir>
      <Mode>rw</Mode>
    </Volume>
  </Data>
  <Config Name="WebUI &amp; API Port" Target="8090" Default="8090" Mode="tcp" Description="HTTP/2 Range Request Server Port" Type="Port" Display="always" Required="true" Mask="false">8090</Config>
  <Config Name="Config File" Target="/app/config.yaml" Default="/mnt/user/appdata/otix-server/config.yaml" Mode="rw" Description="Path to server config.yaml" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/otix-server/config.yaml</Config>
  <Config Name="Game Installers / ISOs" Target="/storage/installers" Default="/mnt/user/games/" Mode="rw" Description="Unraid share containing game ISOs, setup files, repacks, and ROMs" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/games/</Config>
  <Config Name="Cloud Save Backups" Target="/storage/saves" Default="/mnt/user/appdata/otix-server/saves/" Mode="rw" Description="Directory storing automated game save file snapshots" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/otix-server/saves/</Config>
  <Config Name="App Storage &amp; Secrets" Target="/app/storage" Default="/mnt/user/appdata/otix-server/storage/" Mode="rw" Description="Directory for Epic Games token vault and server storage" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/otix-server/storage/</Config>
</Container>
