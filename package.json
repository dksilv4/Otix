{
  "name": "otix",
  "private": true,
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File ./scripts/run.ps1",
    "dev:bash": "bash ./scripts/run.sh",
    "start": "powershell -ExecutionPolicy Bypass -File ./scripts/run.ps1",
    "build:frontend": "npm --prefix frontend run build",
    "package:frontend": "npm --prefix frontend run package:dist",
    "package:desktop": "bash ./scripts/package-desktop.sh",
    "package:desktop:win": "powershell -ExecutionPolicy Bypass -File ./scripts/package-desktop.ps1",
    "package:node": "bash ./node/scripts/build-all.sh",
    "package:node:win": "powershell -ExecutionPolicy Bypass -File ./node/scripts/build-windows.ps1",
    "package:all": "bash ./scripts/package-all.sh",
    "package:all:win": "powershell -ExecutionPolicy Bypass -File ./scripts/package-all.ps1",
    "build:images": "make build-images",
    "prod:up": "make prod-up",
    "prod:down": "make prod-down",
    "test:desktop": "npm test --prefix desktop",
    "test:frontend": "npm test --prefix frontend",
    "clean": "node -e \"const fs=require('fs'); ['dist', 'desktop/release', 'desktop/dist', 'frontend/dist', 'node/dist'].forEach(d => { try { fs.rmSync(d, {recursive: true, force: true}); } catch(e){} });\"",
    "clean:dist": "node -e \"const fs=require('fs'); if (fs.existsSync('dist')) fs.rmSync('dist', {recursive: true, force: true});\"",
    "node:local": "powershell -ExecutionPolicy Bypass -File ./scripts/start_node_local.ps1",
    "node:prod": "powershell -ExecutionPolicy Bypass -File ./scripts/start_node_prod.ps1"
  },
  "dependencies": {
    "headroom-ai": "^0.22.4",
    "ps-list": "^7.2.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
