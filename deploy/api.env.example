# Generated on the VM by deploy/bootstrap-api-vm.sh into deploy/.env
# (gitignored). Values below are the shape, not a working secret set.
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
ALLOWED_HOSTS=YOUR_PUBLIC_IP,localhost,127.0.0.1
POSTGRES_PASSWORD=change-me
POSTGRES_DB=otix
POSTGRES_USER=otix
DATABASE_URL=postgresql://otix:change-me@db:5432/otix
REDIS_URL=redis://redis:6379/1
# Same Redis, so handlers that enqueue work don't dial localhost and fail.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
FRONTEND_URL=http://YOUR_PUBLIC_IP:8000
# Optional. Empty keys leave those provider calls unwired.
TMDB_API_KEY=
TMDB_RAT=
OMDB_API_KEY=
FANART_API_KEY=
LASTFM_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
STEAM_API_KEY=
STEAM_GRID_API_KEY=
