{
  "name": "Sonarr",
  "icon": "tv",
  "stage": "alpha",
  "version": "0.1.0",
  "description": "Sonarr TV series management — browse your Sonarr library, request shows from your Otix watchlist, and scan the shows you already have into the local catalog (fully offline)",
  "author": "Otix",
  "repository": "",
  "system": false,
  "min_app_version": "0.1.0",
  "timeout": 600000,
  "permissions": [
    "network:external",
    "events:subscribe",
    "storage:local",
    "notifications",
    "ui:settings"
  ],
  "services": [
    { "type": "arr", "protocol": "show" }
  ],
  "slots": [
    { "location": "media/detail/actions", "label": "Sonarr" }
  ],
  "db": {
    "tables": {
      "sonarr_import_log": {
        "columns": {
          "tvdb_id": "TEXT NOT NULL",
          "instance_id": "TEXT",
          "otix_media_id": "TEXT",
          "status": "TEXT NOT NULL",
          "title": "TEXT",
          "error": "TEXT",
          "imported_at": "INTEGER NOT NULL"
        },
        "indexes": [
          "CREATE UNIQUE INDEX IF NOT EXISTS idx_sonarr_import_log_tvdb ON sonarr_import_log (tvdb_id)"
        ]
      },
      "sonarr_sync_log": {
        "columns": {
          "id": "INTEGER PRIMARY KEY AUTOINCREMENT",
          "instance_id": "TEXT",
          "started_at": "INTEGER NOT NULL",
          "finished_at": "INTEGER",
          "success": "INTEGER NOT NULL DEFAULT 0",
          "paused": "INTEGER NOT NULL DEFAULT 0",
          "found": "INTEGER NOT NULL DEFAULT 0",
          "imported": "INTEGER NOT NULL DEFAULT 0",
          "skipped": "INTEGER NOT NULL DEFAULT 0",
          "failed": "INTEGER NOT NULL DEFAULT 0",
          "errors": "TEXT",
          "message": "TEXT"
        },
        "indexes": [
          "CREATE INDEX IF NOT EXISTS idx_sonarr_sync_log_started ON sonarr_sync_log (started_at)"
        ]
      },
      "sonarr_requests": {
        "columns": {
          "tvdb_id": "TEXT",
          "tmdb_id": "TEXT",
          "title": "TEXT",
          "instance_id": "TEXT",
          "instance_name": "TEXT",
          "status": "TEXT NOT NULL",
          "source": "TEXT",
          "already_exists": "INTEGER NOT NULL DEFAULT 0",
          "error": "TEXT",
          "requested_at": "INTEGER NOT NULL"
        },
        "indexes": [
          "CREATE INDEX IF NOT EXISTS idx_sonarr_requests_requested ON sonarr_requests (requested_at)",
          "CREATE UNIQUE INDEX IF NOT EXISTS idx_sonarr_requests_tvdb_instance ON sonarr_requests (tvdb_id, instance_id)"
        ]
      },
      "sonarr_downloads": {
        "columns": {
          "download_id": "TEXT PRIMARY KEY",
          "instance_id": "TEXT",
          "queue_id": "TEXT NOT NULL",
          "tvdb_id": "TEXT",
          "series_id": "INTEGER",
          "title": "TEXT",
          "created_at": "INTEGER NOT NULL"
        },
        "indexes": [
          "CREATE UNIQUE INDEX IF NOT EXISTS idx_sonarr_downloads_instance_queue ON sonarr_downloads (instance_id, queue_id)"
        ]
      },
      "sonarr_series": {
        "columns": {
          "tvdb_id": "TEXT PRIMARY KEY",
          "tmdb_id": "TEXT",
          "instance_id": "TEXT",
          "instance_name": "TEXT",
          "title": "TEXT",
          "year": "INTEGER",
          "overview": "TEXT",
          "poster_url": "TEXT",
          "genres": "TEXT",
          "runtime": "INTEGER",
          "rating": "REAL",
          "status": "TEXT",
          "file_path": "TEXT",
          "added_at": "INTEGER NOT NULL",
          "size_on_disk": "INTEGER",
          "monitored": "INTEGER DEFAULT 0",
          "episode_count": "INTEGER DEFAULT 0",
          "episode_file_count": "INTEGER DEFAULT 0"
        },
        "indexes": [
          "CREATE INDEX IF NOT EXISTS idx_sonarr_series_tmdb ON sonarr_series (tmdb_id)",
          "CREATE INDEX IF NOT EXISTS idx_sonarr_series_instance ON sonarr_series (instance_id)"
        ]
      }
    }
  },
  "config": {
    "instances": {
      "type": "instances",
      "label": "Sonarr Instances",
      "description": "Configure one or more Sonarr server instances.",
      "connection": {
        "method": "probe",
        "fields": ["url", "apiKey"]
      },
      "items": {
        "name": {
          "type": "string",
          "label": "Name",
          "description": "e.g. Local Server"
        },
        "url": {
          "type": "serverUrl",
          "label": "Server URL",
          "description": "e.g. http://localhost:8989",
          "placeholder": "http://localhost:8989",
          "parts": ["host", "port", "useSsl", "baseUrl"]
        },
        "apiKey": {
          "type": "secret",
          "label": "API Key",
          "description": "Sonarr security API Key"
        },
        "qualityProfile": {
          "type": "string",
          "label": "Quality Profile",
          "description": "Picked from your Sonarr server",
          "fetchable": true
        },
        "languageProfile": {
          "type": "string",
          "label": "Language Profile",
          "description": "Sonarr v3 only — picked from your Sonarr server",
          "fetchable": true
        },
        "rootFolder": {
          "type": "string",
          "label": "Root Folder",
          "description": "Picked from your Sonarr server",
          "fetchable": true
        },
        "autoRequestWatchlist": {
          "type": "boolean",
          "label": "Auto-request watchlisted shows",
          "description": "Automatically send watchlisted shows to this instance",
          "default": true
        },
        "enabled": {
          "type": "boolean",
          "label": "Enabled",
          "description": "Enable this instance",
          "default": true
        }
      }
    },
    "syncDirection": {
      "type": "enum",
      "label": "Sync Direction",
      "description": "Scans your Sonarr library into the local media catalog",
      "values": ["sonarr-to-otix"],
      "default": "sonarr-to-otix"
    },
    "pollIntervalMinutes": {
      "type": "number",
      "label": "Auto-import interval (minutes)",
      "description": "How often to import new Sonarr shows into Otix. 0 disables automatic syncing.",
      "default": 0
    },
    "trackDownloads": {
      "type": "boolean",
      "label": "Track download status",
      "description": "Sync each show's Sonarr status (missing → downloading → downloaded) and show actively-downloading shows with live progress in the activity downloads panel.",
      "default": true
    }
  },
  "settings": {
    "tabs": [
      {
        "id": "sonarr",
        "label": "Sonarr",
        "icon": "tv",
        "path": "/settings/sonarr",
        "sections": [
          { "id": "config", "label": "Settings", "config": true },
          { "id": "sync", "label": "Sync to local catalog", "sync": true },
          { "id": "shows", "label": "Shows", "movies": true },
          { "id": "requests", "label": "Requests", "requests": true },
          { "id": "syncHistory", "label": "Sync history", "syncHistory": true }
        ]
      }
    ]
  },
  "entry": { "main": "main.js" }
}
