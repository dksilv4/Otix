{
  "name": "SABnzbd",
  "icon": "download",
  "stage": "alpha",
  "version": "0.7.0",
  "description": "SABnzbd usenet download client",
  "author": "Otix",
  "repository": "",
  "system": false,
  "min_app_version": "0.1.0",
  "permissions": [
    "network:external",
    "ui:settings"
  ],
  "services": [
    {
      "type": "downloader",
      "protocol": "usenet"
    }
  ],
  "depends_on": ["downloads"],
  "config": {
    "host": {
      "type": "string",
      "label": "Host",
      "default": "localhost",
      "section": "General",
      "order": 0
    },
    "port": {
      "type": "number",
      "label": "Port",
      "default": 8080,
      "section": "General",
      "order": 1
    },
    "apiKey": {
      "type": "secret",
      "label": "API Key",
      "section": "General",
      "order": 2
    },
    "useSsl": {
      "type": "boolean",
      "label": "Use SSL",
      "default": false,
      "section": "General",
      "order": 3
    },
    "urlBase": {
      "type": "string",
      "label": "URL Base / Subpath",
      "default": "",
      "description": "Optional subpath for reverse proxies (e.g. /sabnzbd)",
      "section": "General",
      "order": 4
    },
    "category": {
      "type": "string",
      "label": "Default Category",
      "default": "games",
      "section": "General",
      "order": 5
    }
  },
  "entry": {
    "main": "main.js"
  }
}
