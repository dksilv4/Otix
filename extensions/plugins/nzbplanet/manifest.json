{
  "name": "NZBPlanet",
  "icon": "search",
  "stage": "alpha",
  "version": "0.7.0",
  "description": "NZBPlanet usenet search provider",
  "author": "Otix",
  "repository": "",
  "system": true,
  "min_app_version": "0.1.0",
  "permissions": [
    "network:external",
    "ui:settings"
  ],
  "services": [
    {
      "type": "search-provider",
      "protocol": "usenet"
    }
  ],
  "depends_on": ["downloads"],
  "config": {
    "apiKey": {
      "type": "secret",
      "label": "API Key",
      "section": "General",
      "order": 0
    },
    "categoryIds": {
      "type": "string",
      "label": "Category IDs",
      "default": "1000,2000",
      "section": "General",
      "order": 1
    }
  },
  "entry": {
    "main": "main.js"
  }
}
