{
  "name": "Radarr",
  "icon": "film",
  "stage": "alpha",
  "version": "0.1.0",
  "description": "Radarr movie management — browse your Radarr library, request movies from your Otix watchlist, and scan the movies you already have into the local catalog (fully offline)",
  "author": "Otix",
  "repository": "",
  "system": false,
  "min_app_version": "0.1.0",
  "timeout": 600000,
  "permissions": [
    "network:external",
    "events:subscribe",
    "storage:local",
    "notifications",
    "ui:settings"
  ],
  "services": [
    { "type": "arr", "protocol": "movie" }
  ],
  "slots": [
    { "location": "media/detail/actions", "label": "Radarr" }
  ],
  "db": {
    "tables": {
      "radarr_import_log": {
        "columns": {
          "tmdb_id": "TEXT NOT NULL",
          "instance_id": "TEXT",
          "otix_media_id": "TEXT",
          "status": "TEXT NOT NULL",
          "title": "TEXT",
          "error": "TEXT",
          "imported_at": "INTEGER NOT NULL"
        },
        "indexes": [
          "CREATE UNIQUE INDEX IF NOT EXISTS idx_radarr_import_log_tmdb ON radarr_import_log (tmdb_id)"
        ]
      },
      "radarr_sync_log": {
        "columns": {
          "id": "INTEGER PRIMARY KEY AUTOINCREMENT",
          "instance_id": "TEXT",
          "started_at": "INTEGER NOT NULL",
          "finished_at": "INTEGER",
          "success": "INTEGER NOT NULL DEFAULT 0",
          "paused": "INTEGER NOT NULL DEFAULT 0",
          "found": "INTEGER NOT NULL DEFAULT 0",
          "imported": "INTEGER NOT NULL DEFAULT 0",
          "skipped": "INTEGER NOT NULL DEFAULT 0",
          "failed": "INTEGER NOT NULL DEFAULT 0",
          "errors": "TEXT",
          "message": "TEXT"
        },
        "indexes": [
          "CREATE INDEX IF NOT EXISTS idx_radarr_sync_log_started ON radarr_sync_log (started_at)"
        ]
      },
      "radarr_requests": {
        "columns": {
          "tmdb_id": "TEXT NOT NULL",
          "title": "TEXT",
          "instance_id": "TEXT",
          "instance_name": "TEXT",
          "status": "TEXT NOT NULL",
          "source": "TEXT",
          "already_exists": "INTEGER NOT NULL DEFAULT 0",
          "error": "TEXT",
          "requested_at": "INTEGER NOT NULL"
        },
        "indexes": [
          "CREATE INDEX IF NOT EXISTS idx_radarr_requests_requested ON radarr_requests (requested_at)",
          "CREATE UNIQUE INDEX IF NOT EXISTS idx_radarr_requests_tmdb_instance ON radarr_requests (tmdb_id, instance_id)"
        ]
      },
      "radarr_downloads": {
        "columns": {
          "download_id": "TEXT PRIMARY KEY",
          "instance_id": "TEXT",
          "queue_id": "TEXT NOT NULL",
          "tmdb_id": "TEXT",
          "movie_id": "INTEGER",
          "title": "TEXT",
          "created_at": "INTEGER NOT NULL"
        },
        "indexes": [
          "CREATE UNIQUE INDEX IF NOT EXISTS idx_radarr_downloads_instance_queue ON radarr_downloads (instance_id, queue_id)"
        ]
      },
      "radarr_movies": {
        "columns": {
          "tmdb_id": "TEXT PRIMARY KEY",
          "instance_id": "TEXT",
          "instance_name": "TEXT",
          "title": "TEXT",
          "year": "INTEGER",
          "overview": "TEXT",
          "poster_url": "TEXT",
          "genres": "TEXT",
          "runtime": "INTEGER",
          "rating": "REAL",
          "status": "TEXT",
          "file_path": "TEXT",
          "size_on_disk": "INTEGER",
          "monitored": "INTEGER DEFAULT 0",
          "added_at": "INTEGER NOT NULL"
        },
        "indexes": [
          "CREATE INDEX IF NOT EXISTS idx_radarr_movies_instance ON radarr_movies (instance_id)"
        ]
      }
    }
  },
  "config": {
    "instances": {
      "type": "instances",
      "label": "Radarr Instances",
      "description": "Configure one or more Radarr server instances.",
      "connection": {
        "method": "probe",
        "fields": ["url", "apiKey"]
      },
      "items": {
        "name": {
          "type": "string",
          "label": "Name",
          "description": "e.g. Local Server"
        },
        "url": {
          "type": "serverUrl",
          "label": "Server URL",
          "description": "e.g. http://localhost:7878/radarr",
          "placeholder": "http://localhost:7878/radarr",
          "parts": ["host", "port", "useSsl", "baseUrl"]
        },
        "apiKey": {
          "type": "secret",
          "label": "API Key",
          "description": "Radarr security API Key"
        },
        "qualityProfile": {
          "type": "string",
          "label": "Quality Profile",
          "description": "Picked from your Radarr server",
          "fetchable": true
        },
        "rootFolder": {
          "type": "string",
          "label": "Root Folder",
          "description": "Picked from your Radarr server",
          "fetchable": true
        },
        "autoRequestWatchlist": {
          "type": "boolean",
          "label": "Auto-request watchlisted movies",
          "description": "Automatically send watchlisted movies to this instance",
          "default": true
        },
        "enabled": {
          "type": "boolean",
          "label": "Enabled",
          "description": "Enable this instance",
          "default": true
        }
      }
    },
    "syncDirection": {
      "type": "enum",
      "label": "Sync Direction",
      "description": "Scans your Radarr library into the local media catalog",
      "values": ["radarr-to-otix"],
      "default": "radarr-to-otix"
    },
    "pollIntervalMinutes": {
      "type": "number",
      "label": "Auto-import interval (minutes)",
      "description": "How often to import new Radarr movies into Otix. 0 disables automatic syncing.",
      "default": 0
    },
    "trackDownloads": {
      "type": "boolean",
      "label": "Track download status",
      "description": "Sync each movie's Radarr status (missing → downloading → downloaded) and show actively-downloading movies with live progress in the activity downloads panel.",
      "default": true
    }
  },
  "settings": {
    "tabs": [
      {
        "id": "radarr",
        "label": "Radarr",
        "icon": "film",
        "path": "/settings/radarr",
        "sections": [
          { "id": "config", "label": "Settings", "config": true },
          { "id": "sync", "label": "Sync to local catalog", "sync": true },
          { "id": "movies", "label": "Movies", "movies": true },
          { "id": "requests", "label": "Requests", "requests": true },
          { "id": "syncHistory", "label": "Sync history", "syncHistory": true }
        ]
      }
    ]
  },
  "entry": { "main": "main.js" }
}
