{
  "name": "Epic Games Scanner",
  "version": "1.0.0",
  "description": "Sign in with Epic Games to sync your full game library — owned titles, metadata, and cover art. Also scans locally installed games from Epic Launcher manifests.",
  "author": "Diogo da Silva",
  "repository": "https://github.com/otix-community/otix-epic-games",
  "min_app_version": "0.3.0",
  "permissions": ["network:external", "storage:local", "events:subscribe", "notifications", "ui:settings"],
  "config": {
    "_epic_login": {
      "type": "string",
      "label": "Epic Games Account"
    },
    "auto_sync": {
      "type": "boolean",
      "label": "Auto-sync on login",
      "default": true
    },
    "refresh_token": {
      "type": "secret",
      "label": "Refresh Token (auto-managed)",
      "advanced": true
    },
    "account_id": {
      "type": "string",
      "label": "Account ID (auto-managed)",
      "advanced": true
    },
    "display_name": {
      "type": "string",
      "label": "Display Name (auto-managed)",
      "advanced": true
    }
  },
  "entry": { "main": "main.js" },
  "icon": "gamecontroller.fill"
}
