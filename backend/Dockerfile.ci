FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

WORKDIR /repo/backend

# Install dependencies using locked uv file
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen

# Copy backend source and sample_data adjacent to backend so fixtures resolve
COPY backend /repo/backend
COPY sample_data /repo/sample_data

ENV DJANGO_SETTINGS_MODULE=config.settings.test

CMD ["sh", "-c", "uv run ruff check . && uv run python manage.py makemigrations --check --dry-run && uv run python manage.py test"]
