# Keep the build context lean. Deps install from uv.lock; source is baked via
# `COPY . /app` for image-only (prod) runs and hidden by the dev bind mount.
# Everything below is dev/runtime-local state that must never reach an image.
.venv/
**/__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.ruff_cache/
.pytest_cache/
.fastembed_cache/
graphify-out/
.coverage
htmlcov/
staticfiles/
/media/
/uploads/
/celerybeat-schedule/
*.sqlite3
*.db
.env
/Dockerfile
/.dockerignore
/README.md
/ARCHITECTURE.md
/.gitignore
/plugin-root/
/deploy/
/bundled_plugins/
/tests/
